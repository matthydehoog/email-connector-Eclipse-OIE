<connectorMetaData path="email-reader">
	<name>Email Reader</name>
	<author>X Connections</author>
	<pluginVersion>3.0.0</pluginVersion>
	<mirthVersion>4.6.0</mirthVersion>
	<url>https://x-connections.info</url>
	<description>This connector allows Open Integration Engine to poll a POP3 or IMAP mailbox and hand every mail to the channel as a plain-text XML message (subject, from, to, sentDate, body).</description>
	<clientClassName>com.mirth.connect.connectors.email.client.EmailReader</clientClassName>
	<serverClassName>com.mirth.connect.connectors.email.server.EmailReceiver</serverClassName>
	<sharedClassName>com.mirth.connect.connectors.email.shared.EmailReceiverProperties</sharedClassName>
	<library type="CLIENT" path="emailreader-client.jar" />
	<library type="SHARED" path="emailreader-shared.jar" />
	<library type="SERVER" path="emailreader-server.jar" />
	<library type="SERVER" path="lib/jakarta.mail-api-2.1.3.jar" />
	<library type="SERVER" path="lib/jakarta.activation-api-2.1.3.jar" />
	<library type="SERVER" path="lib/angus-mail-2.0.3.jar" />
	<library type="SERVER" path="lib/angus-activation-2.0.2.jar" />
	<transformers></transformers>
	<protocol>email</protocol>
	<type>SOURCE</type>
</connectorMetaData>
